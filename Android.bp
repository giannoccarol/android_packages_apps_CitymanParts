// Device settings: the performance profiles in Settings > Battery and a
// Quick Settings tile (power/README.md of the device tree), with a
// launcher icon.
android_app {
    name: "CitymanParts",
    srcs: [
        "src/**/*.java",
        ":CitymanCameraKeyConfig",
    ],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    static_libs: [
        "androidx.core_core",
        "androidx.preference_preference",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibFooterPreference",
        "SettingsLibSelectorWithWidgetPreference",
        "SettingsLibSettingsTheme",
    ],

    optimize: {
        enabled: false,
    },
}

filegroup {
    name: "CitymanCameraKeyConfig",
    srcs: ["keyhandler/src/org/lineageos/cityman/keyhandler/CameraKeyConfig.java"],
}

// Camera button handler, loaded into system_server through
// config_deviceKeyHandlerLibs.
java_library {
    name: "CitymanKeyHandler",
    srcs: ["keyhandler/src/**/*.java"],
    system_ext_specific: true,
    installable: true,
    dex_preopt: {
        enabled: false,
    },
}
