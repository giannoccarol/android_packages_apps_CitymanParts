<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_name">Device settings</string>

    <string name="perf_profile_title">Performance profile</string>
    <string name="perf_profile_tile_label">Performance</string>

    <string name="profile_power_save">Power save</string>
    <string name="profile_power_save_summary">A53 cores only, up to 1.25 GHz. Longest battery life; apps open more slowly.</string>
    <string name="profile_balanced">Balanced</string>
    <string name="profile_balanced_summary">Up to two A57 cores at 1.44 GHz. Recommended.</string>
    <string name="profile_performance">Performance</string>
    <string name="profile_performance_summary">All eight cores, no profile limit. Uses more battery and warms the phone; thermal protection still slows the A57 cores when hot.</string>

    <string name="profile_battery_saver_summary"><xliff:g id="profile" example="Power save">%1$s</xliff:g> (Battery Saver)</string>
    <string name="profile_battery_saver_note">Battery Saver is on and uses Power save. Your choice applies again when it turns off.</string>

    <string name="usb_otg_tile_label">USB OTG</string>
    <string name="usb_otg_on">Host: keyboards, controllers, drives. Unplug any charger</string>
    <string name="usb_otg_off">Off: charging and PC connection</string>
    <string name="camera_key_title">Camera button</string>
    <string name="camera_key_settings_summary">Choose what the button does</string>
    <string name="camera_key_short_title">Press</string>
    <string name="camera_key_long_title">Press and hold</string>
    <string name="camera_key_screen_off_title">Use when off or locked</string>
    <string name="camera_key_screen_off_summary">Hold the button until it vibrates. A short press does nothing, so it does not go off in your pocket.</string>
    <string name="camera_key_close_title">Close the camera when the screen turns off</string>
    <string name="camera_key_close_summary">The next press opens the camera instead of taking a photo.</string>
    <string name="camera_key_footer">In a camera app the button works as usual: press halfway to focus, all the way to take the photo.</string>
    <string name="camera_key_action_none">No action</string>
    <string name="camera_key_action_camera">Open the camera</string>
    <string name="camera_key_action_torch">Flashlight on or off</string>
    <string name="camera_key_action_app">Open an app\u2026</string>
    <string name="camera_key_action_app_named">Open <xliff:g id="app" example="Maps">%1$s</xliff:g></string>
    <string name="camera_key_app_missing">Open an app (not installed)</string>
    <string name="camera_key_pick_app">Choose an app</string>
</resources>
